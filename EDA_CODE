import pandas as pd

from google.colab import files
uploaded = files.upload()

# Load the dataset
df = pd.read_excel('movies_metadata.xlsx')

# 1. Number of rows
print("Number of rows:", df.shape[0])

# 2. Number of columns
print("Number of columns:", df.shape[1])

# 3. Data types
print("\nData types:\n", df.dtypes)

print(df.dtypes.value_counts())

# 4. Missing values (count and % per column)
missing = df.isnull().sum()
missing_pct = (missing / len(df)) * 100
missing_summary = pd.DataFrame({'missing_count': missing, 'missing_pct': missing_pct})
print("\nMissing values:\n", missing_summary[missing_summary['missing_count'] > 0].sort_values('missing_count', ascending=False))

# 5. Duplicate rows
print("\nNumber of duplicate rows:", df.duplicated().sum())

# 6. Summary statistics
print("\nSummary statistics (numeric columns):\n", df.describe())
